# Application Configuration
APP_NAME="Enterprise Document Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/document_intelligence"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_intelligence"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Security & Authentication
JWT_SECRET_KEY="super_secret_jwt_key_please_change_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./storage"

# Embedding Configuration (Default: Free local HuggingFace model)
EMBEDDING_PROVIDER="huggingface"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Reranking Configuration
RERANKING_ENABLED=true
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RRF_K=60

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"

# Limits & Quotas
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_FILES=100
MAX_ZIP_EXTRACTED_SIZE_MB=500
MAX_ZIP_NESTING_DEPTH=1

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"

